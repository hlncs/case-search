# Database Configuration
DATABASE_URL=postgresql://aiuser:aipassword@localhost:5432/ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=120
OLLAMA_NUM_PREDICT=256

# Embedding Model
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SSL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# EMBEDDING_MODEL_PATH=./data/models/all-MiniLM-L6-v2

# File Handling
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# RAG Configuration
RAG_MAX_CHUNKS=5
RAG_SYSTEM_PROMPT=You are a legal case analyst. Answer the user's question using ONLY the provided case excerpts. Always cite the case names and years.

# Agent Configuration
AGENT_TEMPERATURE=0.7

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# API
API_TITLE=Legal Case Search API
API_VERSION=1.0.0
DEBUG=False

